{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "Write(specs/tmp/**/.verify/**)",
      "Edit(specs/tmp/**/.verify/**)",
      "Write(specs/tmp/**/.implement/**)",
      "Edit(specs/tmp/**/.implement/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/title.sh --reset" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/title.sh --busy" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/title.sh --agent-start" }]
      }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/title.sh --agent-stop" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/title.sh --idle" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/title.sh --done" }] }
    ]
  }
}
